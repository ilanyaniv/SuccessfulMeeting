{
  "name": "A2 - Send meeting goals link (Successful Meetings)",
  "flow": [
    {
      "id": 1,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "tlsType": "",
        "apiKeyAccount": 12146815,
        "authenticationType": "apiKeyConnection"
      },
      "mapper": {
        "url": "https://xldpeyvxruhdhrbprluj.supabase.co/rest/v1/meetings?select=meeting_id,title,scheduled_date,inviter&goals_requested_at=is.null&goals_status=eq.Pending&excluded=is.false",
        "method": "get",
        "headers": [],
        "parseResponse": true,
        "timeout": "40",
        "shareCookies": false,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "tlsType": {
              "label": "Empty"
            },
            "apiKeyAccount": {
              "data": {
                "scoped": "true",
                "connection": "http-v4-apikey"
              },
              "label": "Ilan's API Key connection (Any public HTTPS service)"
            },
            "authenticationType": {
              "label": "API keyUse a saved API key connection with service URL restrictions."
            }
          }
        },
        "parameters": [
          {
            "name": "authenticationType",
            "type": "select",
            "label": "Authentication type",
            "required": true,
            "validate": {
              "enum": [
                "noAuth",
                "apiKeyConnection",
                "basicAuthConnection",
                "oAuth",
                "apiKey",
                "basicAuth"
              ]
            }
          },
          {
            "name": "tlsType",
            "type": "select",
            "label": "Transport layer security (TLS)",
            "validate": {
              "enum": [
                "mTls",
                "tls"
              ]
            }
          },
          {
            "name": "proxyKeychain",
            "type": "keychain:proxy",
            "label": "Proxy"
          },
          {
            "name": "apiKeyAccount",
            "type": "account:http-v4-apikey",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{1.data}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 3,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {
        "__IMTCONN__": null
      },
      "filter": {
        "name": "Inviter has an email",
        "conditions": [
          [
            {
              "a": "{{2.inviter}}",
              "o": "exist"
            }
          ]
        ]
      },
      "mapper": {
        "to": [
          "{{2.inviter}}"
        ],
        "subject": "Set the goal for your meeting: {{2.title}}",
        "bodyType": "rawHtml",
        "contents": "<p>Hi,</p><p>You scheduled <b>{{2.title}}</b> on {{2.scheduled_date}}. Before the meeting, please state its goal:</p><ul><li>What is the purpose of the meeting?</li><li>What should come out of it: answers, decisions, timetable?</li><li>Any action items you already know about.</li></ul><p><a href=\"https://YOUR-APP.lovable.app/meetings/{{2.meeting_id}}/goals\">Open the meeting goals page</a></p><p>It takes about two minutes. Thanks!<br>Successful Meetings</p>"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {}
      },
      "onerror": [
        {
          "id": 5,
          "module": "builtin:Ignore",
          "version": 1,
          "parameters": {},
          "mapper": null,
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "tlsType": "",
        "apiKeyAccount": 12146815,
        "authenticationType": "apiKeyConnection"
      },
      "mapper": {
        "url": "https://xldpeyvxruhdhrbprluj.supabase.co/rest/v1/meetings?meeting_id=eq.{{2.meeting_id}}&excluded=is.false",
        "method": "patch",
        "headers": [
          {
            "name": "Prefer",
            "value": "return=minimal"
          }
        ],
        "parseResponse": false,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\n  \"goals_requested_at\": \"{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\")}}\",\n  \"summary_document\": \"https://YOUR-APP.lovable.app/meetings/{{2.meeting_id}}\"\n}",
        "timeout": "40",
        "shareCookies": false,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "parameters": {
            "tlsType": {
              "label": "Empty"
            },
            "apiKeyAccount": {
              "data": {
                "scoped": "true",
                "connection": "http-v4-apikey"
              },
              "label": "Ilan's API Key connection (Any public HTTPS service)"
            },
            "authenticationType": {
              "label": "API keyUse a saved API key connection with service URL restrictions."
            }
          }
        },
        "parameters": [
          {
            "name": "authenticationType",
            "type": "select",
            "label": "Authentication type",
            "required": true,
            "validate": {
              "enum": [
                "noAuth",
                "apiKeyConnection",
                "basicAuthConnection",
                "oAuth",
                "apiKey",
                "basicAuth"
              ]
            }
          },
          {
            "name": "tlsType",
            "type": "select",
            "label": "Transport layer security (TLS)",
            "validate": {
              "enum": [
                "mTls",
                "tls"
              ]
            }
          },
          {
            "name": "proxyKeychain",
            "type": "keychain:proxy",
            "label": "Proxy"
          },
          {
            "name": "apiKeyAccount",
            "type": "account:http-v4-apikey",
            "label": "Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com"
  }
}