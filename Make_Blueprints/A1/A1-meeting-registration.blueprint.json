      "filter": {
        "name": "Enough attendees, created in the last 24 hours, starts today or later",
        "conditions": [
          [
            {
              "a": "{{length(1.attendees)}}",
              "b": "{{2.data.min_attendees}}",
              "o": "number:greaterorequal"
            },
            {
              "a": "{{ifempty(1.start.dateTime; ifempty(1.start.date; 1.start))}}",
              "o": "exist"
            },
            {
              "a": "{{ifempty(1.start.dateTime; ifempty(1.start.date; 1.start))}}",
              "b": "{{parseDate(formatDate(now; \"YYYY-MM-DD\"); \"YYYY-MM-DD\")}}",
              "o": "date:greaterorequal"
            },
            {
              "a": "{{1.created}}",
              "b": "{{addDays(now; -1)}}",
              "o": "date:greaterorequal"
            }
          ]
        ]
      },
      "mapper": {
        "url": "https://xldpeyvxruhdhrbprluj.supabase.co/rest/v1/meetings?on_conflict=calendar_event_id",
        "method": "post",
        "headers": [
          {
            "name": "Prefer",
            "value": "resolution=ignore-duplicates,return=minimal"
          }
        ],
        "timeout": "40",
        "contentType": "json",
        "inputMethod": "jsonString",
        "shareCookies": false,
        "parseResponse": false,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "jsonStringBodyContent": "{\n  \"calendar_event_id\": \"{{1.id}}\",\n  \"title\": \"{{replace(replace(1.summary; \"/\\x5C/g\"; \"/\"); \"/\\x22/g\"; \"'\")}}\",\n  \"scheduled_date\": \"{{formatDate(ifempty(1.start.dateTime; ifempty(1.start.date; 1.start)); \"YYYY-MM-DD\")}}\",\n  \"start_time\": \"{{formatDate(ifempty(1.start.dateTime; ifempty(1.start.date; 1.start)); \"YYYY-MM-DDTHH:mm:ssZ\")}}\",\n  \"end_time\": \"{{formatDate(ifempty(1.end.dateTime; ifempty(1.end.date; 1.end)); \"YYYY-MM-DDTHH:mm:ssZ\")}}\",\n  \"inviter\": \"{{1.organizer.email}}\",\n  \"attendees\": \"{{join(map(1.attendees; \"email\"); \", \")}}\",\n  \"excluded\": {{if(contains(lower(ifempty(1.summary; \"\")); \"#exclude\"); \"true\"; if(contains(lower(ifempty(1.description; \"\")); \"#exclude\"); \"true\"; \"false\"))}}\n}",
        "requestCompressedContent": true
      },
