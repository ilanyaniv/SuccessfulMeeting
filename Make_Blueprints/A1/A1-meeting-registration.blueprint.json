{
  "name": "A1 - Meeting registration (Successful Meetings, Supabase)",
  "flow": [
    {
      "id": 1,
      "module": "google-calendar:watchEvents",
      "version": 5,
      "parameters": {
        "__IMTCONN__": null,
        "calendar": "primary",
        "watchBy": "created",
        "showDeleted": false,
        "singleEvents": false,
        "maxResults": 10
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 2,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://YOUR-PROJECT-REF.supabase.co/rest/v1/settings?select=min_attendees&id=eq.1",
        "method": "get",
        "headers": [
          {
            "name": "apikey",
            "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
          },
          {
            "name": "Authorization",
            "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
          },
          {
            "name": "Accept",
            "value": "application/vnd.pgrst.object+json"
          }
        ],
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 3,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "filter": {
        "name": "Enough attendees and has a start time",
        "conditions": [
          [
            {
              "a": "{{length(1.attendees)}}",
              "b": "{{2.data.min_attendees}}",
              "o": "number:greaterorequal"
            },
            {
              "a": "{{ifempty(1.start.dateTime; ifempty(1.start.date; 1.start))}}",
              "o": "exist"
            }
          ]
        ]
      },
      "mapper": {
        "url": "https://YOUR-PROJECT-REF.supabase.co/rest/v1/meetings?on_conflict=calendar_event_id",
        "method": "post",
        "headers": [
          {
            "name": "apikey",
            "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
          },
          {
            "name": "Authorization",
            "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
          },
          {
            "name": "Prefer",
            "value": "resolution=ignore-duplicates,return=minimal"
          }
        ],
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\n  \"calendar_event_id\": \"{{1.id}}\",\n  \"title\": \"{{replace(replace(1.summary; \"/\\x5C/g\"; \"/\"); \"/\\x22/g\"; \"'\")}}\",\n  \"scheduled_date\": \"{{formatDate(ifempty(1.start.dateTime; ifempty(1.start.date; 1.start)); \"YYYY-MM-DD\")}}\",\n  \"start_time\": \"{{formatDate(ifempty(1.start.dateTime; ifempty(1.start.date; 1.start)); \"YYYY-MM-DDTHH:mm:ssZ\")}}\",\n  \"end_time\": \"{{formatDate(ifempty(1.end.dateTime; ifempty(1.end.date; 1.end)); \"YYYY-MM-DDTHH:mm:ssZ\")}}\",\n  \"inviter\": \"{{1.organizer.email}}\",\n  \"attendees\": \"{{join(map(1.attendees; \"email\"); \", \")}}\"\n}",
        "parseResponse": false
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {}
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}